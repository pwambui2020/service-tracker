.navbar {
  display: grid;
  /* justify-content: flex-end;
  align-items: center; */
  height: 48px;
  padding: 16px;
  color: #108ee9;
  font-weight: bold;

  /* background-color: rgb(234, 167, 167); */
}
.body {
  height: 100vh;
  width: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-text.active {
  color: #1890ff;
  font-weight: bold;
  border-bottom: 2rpx solid #1890ff;
}
.nav-text {
  font-size: 48rpx;
  margin: 0 30rpx;
}


.about {
  font-size: 16px;
  justify-content: flex-start;
  font-weight: bold;
  color: #108ee9;
  /* padding: 40rpx; */
  /* margin-bottom: 32rpx; */
}
.title-1 {
  font-display: 40px;
  font-weight: bold;
}

.ant-button {
  margin-top: 32rpx;
  width: 100%;
  height: 40px;
  border-radius: 5px;
  /* background-color: aquamarine; */

}

